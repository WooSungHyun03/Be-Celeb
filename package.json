{
  "name": "be-celeb",
  "version": "0.1.0",
  "private": true,
  "description": "Be Celeb monorepo skeleton for SNS trend strategy recommendations.",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cd apps/api && uvicorn app.main:app --reload",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "type-check:web": "npm --workspace apps/web run type-check",
    "db:link": "npx -y supabase@2.98.2 link",
    "db:migration:new": "npx -y supabase@2.98.2 migration new",
    "db:push": "npx -y supabase@2.98.2 db push",
    "db:push:seed": "npx -y supabase@2.98.2 db push --include-seed",
    "db:reset": "npx -y supabase@2.98.2 db reset"
  }
}
